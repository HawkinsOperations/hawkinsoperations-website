{
  "name": "hawkinsoperations-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/finalize-dist.mjs",
    "check:site": "node scripts/verify-site-contract.mjs",
    "preview": "npx --yes serve dist",
    "test:visual": "playwright test",
    "test:visual:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "public-status:generate": "node scripts/generate-public-status.mjs",
    "public-status:generate:check": "node scripts/generate-public-status.mjs --check",
    "public-status:verify": "node scripts/verify-public-status.mjs",
    "public-status:self-test": "node scripts/verify-public-status.mjs --self-test",
    "public-status:owner-self-test": "node scripts/verify-public-status.mjs --owner-self-test-only",
    "public-status:source-checkout-test": "node scripts/verify-public-status.mjs --source-checkout-test",
    "public-status:checkout-manifest-self-test": "node scripts/resolve-public-status-checkouts.mjs --self-test",
    "public-status:freshness-reachability-test": "node scripts/verify-public-status.mjs --freshness-reachability-test",
    "public-status:dirty-provenance-test": "node scripts/verify-public-status.mjs --dirty-provenance-test",
    "public-status:nested-claim-test": "node scripts/verify-public-status.mjs --nested-claim-test",
    "public-status:strict-json-test": "node scripts/verify-public-status.mjs --strict-json-test",
    "public-status:eol-self-test": "node scripts/verify-public-status.mjs --eol-self-test",
    "generate:brand-assets": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3"
  }
}
